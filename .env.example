# ==============================================================================
# AICTE Integrated Institution Complaint Monitoring & Status Dashboard
# Environment Configuration Template (.env.example)
# Duplicate this file as .env or export these variables to configure the app.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aicte_complaints
DB_USERNAME=root
DB_PASSWORD=Root

# Spring Data JPA / Hibernate Settings
JPA_DDL_AUTO=update
SHOW_SQL=false

# Spring Security & JWT Configuration
# Minimum 256-bit (32 character) secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Upload Configuration
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# Frontend Config (mirror in frontend/js/config.js)
VITE_API_BASE_URL=http://localhost:8080/api/v1
